+    @staticmethod
+    def _minmax(x, dim=1, eps=1e-6):
+        """Per-sample min-max normalize along `dim` to [0,1] for stable blending."""
+        mn = x.amin(dim=dim, keepdim=True)
+        mx = x.amax(dim=dim, keepdim=True)
+        return (x - mn) / (mx - mn + eps)
+
+    def compute_importance(self, rec_score, rec_velo, rec_memory):
+        """Physics-guided importance per query. (B,N,1).
+        EDA: Doppler(|v_comp|) is the valid physical foreground signal; RCS is not.
+        cls-score stays as the detection-confidence base term."""
+        if 'quality' in self.select_mode:
+            # learned, SUPERVISED objectness as the base selection score (trained, not hand-crafted)
+            imp = self.quality_branches[self._select_layer](rec_memory).sigmoid()  # (B,N,1)
+        else:
+            imp = rec_score  # (B,N,1) max sigmoid cls
+        if ('doppler' in self.select_mode) or ('mlp' in self.select_mode):
+            speed = rec_velo.norm(dim=-1, keepdim=True)                 # (B,N,1) = |predicted velocity|
+            imp = imp + self.select_velo_weight * self._minmax(speed)
+        if 'mlp' in self.select_mode:
+            imp = imp + self._minmax(self.importance_head(rec_memory))  # learned non-linear importance
+        return imp
+
+    def _mmr_select(self, imp, xy, K):
+        """Greedy MMR: importance + spatial diversity (redundancy suppression).
+        imp:(B,N) ; xy:(B,N,2) ; returns indices (B,K,1)."""
+        B, N = imp.shape
+        imp = self._minmax(imp.unsqueeze(-1), dim=1).squeeze(-1)        # (B,N) in [0,1]
+        gamma, sigma = self.select_mmr_gamma, self.select_mmr_sigma
+        out = []
+        for b in range(B):
+            p = self._minmax(xy[b].unsqueeze(0), dim=1).squeeze(0)      # (N,2) xy normalized to unit box
+            sim = torch.exp(-torch.cdist(p, p).pow(2) / (2 * sigma * sigma))  # (N,N) in (0,1]
+            red = torch.zeros(N, device=imp.device)                    # max sim to selected set
+            chosen = torch.zeros(N, dtype=torch.bool, device=imp.device)
+            sel = []
+            for _ in range(K):
+                score = (imp[b] - gamma * red).masked_fill(chosen, float('-inf'))
+                j = torch.argmax(score)
+                sel.append(j)
+                chosen[j] = True
+                red = torch.maximum(red, sim[j])
+            out.append(torch.stack(sel))
+        return torch.stack(out).unsqueeze(-1)                          # (B,K,1)
+
+    def select_memory_indices(self, rec_score, rec_velo, rec_reference_points, rec_memory):
+        """Pick topk_proposals query indices to propagate into temporal memory.
+        Returns (B,K,1) indices compatible with topk_gather."""
+        K = self.topk_proposals
+        if self.select_mode == 'cls':                                   # baseline: pure cls-score
+            _, idx = torch.topk(rec_score, K, dim=1)
+            return idx
+        imp = self.compute_importance(rec_score, rec_velo, rec_memory)
+        if not self.select_mode.endswith('mmr'):                        # importance-only
+            _, idx = torch.topk(imp, K, dim=1)
+            return idx
+        return self._mmr_select(imp.squeeze(-1), rec_reference_points[..., :2], K)  # importance + diversity
